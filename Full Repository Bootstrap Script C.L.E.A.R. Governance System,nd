#!/usr/bin/env bash
set -e

echo "Bootstrapping full C.L.E.A.R. Governance repository structure..."
ROOT=$(pwd)

# --- Helper function ---
create_file() {
    local path="$1"
    local content="$2"

    if [ -f "$path" ]; then
        echo "Skipping existing file: $path"
    else
        echo "Creating file: $path"
        echo "$content" > "$path"
    fi
}

create_dir() {
    local path="$1"
    echo "Ensuring directory exists: $path"
    mkdir -p "$path"
}

